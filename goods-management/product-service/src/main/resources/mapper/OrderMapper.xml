<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yyy.product.mapper.OrderMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `order`(product_id, buy_num)
        VALUES(#{productId}, #{buyNum})
    </insert>

    <select id="selectAll" resultType="com.yyy.product.entity.Order">
        SELECT id,product_id AS productId,buy_num AS buyNum,create_time AS createTime
        FROM `order`
        ORDER BY create_time DESC
    </select>


</mapper>
